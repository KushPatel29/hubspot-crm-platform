/**
 * The Apex guardrail against its spec and against the Python guardrail, deal by deal (GuardrailParity is generated by
 * python -m crm_platform.salesforce.metadata from the same records the Python and JavaScript versions are tested on).
 */
@IsTest
private class GuardrailServiceTest {
    private static final Double DELTA = 0.000000001;

    // Assert.areEqual has no tolerance; doubles from two languages are compared to 1e-9.
    private static void near(Double expected, Double actual, String label) {
        Assert.isTrue(Math.abs(expected - actual) <= DELTA, label + ': expected ' + expected + ', got ' + actual);
    }

    @IsTest
    static void bandFloorsAtFivePercent() {
        GuardrailService.LineScore wide = GuardrailService.scoreLine(100, 60, 1, 0.3);
        near(0.21, wide.floor, 'floor');
        near(0.38, wide.stretch, 'stretch');
        near(0.05, GuardrailService.scoreLine(100, 60, 1, 0.1).floor, 'floor never under 5%');
    }

    @IsTest
    static void verdictAndSignatureAgainstThirtyPercent() {
        // margin, verdict, approver: the table hubspot/tests/shared.test.js checks the JavaScript version with
        List<List<Object>> cases = new List<List<Object>>{
            new List<Object>{ 0.4, 'Above stretch', 'None' },
            new List<Object>{ 0.3, 'At target', 'None' },
            new List<Object>{ 0.28, 'Below target', 'Rep' },
            new List<Object>{ 0.25, 'Below target', 'Sales manager' },
            new List<Object>{ 0.2, 'Below floor', 'Commercial director' },
            new List<Object>{ 0.1, 'Below floor', 'VP Finance' },
            new List<Object>{ -0.05, 'Loss-making', 'VP Finance' }
        };
        for (List<Object> c : cases) {
            Double margin = ((Decimal) c[0]).doubleValue(); // a 0.4 literal in a List<Object> is a Decimal
            GuardrailService.LineScore s = GuardrailService.scoreLine(100, 100 * (1 - margin), 1, 0.3);
            Assert.areEqual(c[1], s.verdict, 'verdict at ' + margin);
            Assert.areEqual(c[2], s.approver, 'approver at ' + margin);
        }
    }

    @IsTest
    static void worstLineAndMostSeniorSignature() {
        GuardrailService.DealScore deal = GuardrailService.scoreDeal(new List<GuardrailService.Line>{
            new GuardrailService.Line(100, 60, 1, 0.3),
            new GuardrailService.Line(100, 75, 1, 0.3),
            new GuardrailService.Line(100, 71, 5, 0.3)
        });
        Assert.areEqual('Below target', deal.verdict);
        Assert.areEqual(1, deal.worstLine);
        Assert.areEqual('Sales manager', deal.approver);
        Double blended = 0.3; // 210 of margin on 700 of revenue
        near(blended, deal.blendedMarginPct, 'blended margin');
        GuardrailService.DealScore empty = GuardrailService.scoreDeal(new List<GuardrailService.Line>());
        Assert.areEqual('None', empty.approver);
        Assert.areEqual(-1, empty.worstLine);
    }

    @IsTest
    static void optionValuesMatchTheGeneratedPicklists() {
        Assert.areEqual('below_floor', GuardrailService.optionValue('Below floor'));
        Assert.areEqual('loss_making', GuardrailService.optionValue('Loss-making'));
        Assert.areEqual('vp_finance', GuardrailService.optionValue('VP Finance'));
        Assert.isNull(GuardrailService.optionValue(null));
    }

    @IsTest
    static void everyMeridianDealScoresAsThePythonGuardrailDoes() {
        StaticResource fixture = [SELECT Body FROM StaticResource WHERE Name = 'GuardrailParity' LIMIT 1];
        List<Object> deals = (List<Object>) JSON.deserializeUntyped(fixture.Body.toString());
        Assert.areEqual(359, deals.size(), 'the fixture holds every Meridian deal');
        for (Object item : deals) {
            Map<String, Object> expected = (Map<String, Object>) item;
            List<GuardrailService.Line> lines = new List<GuardrailService.Line>();
            for (Object raw : (List<Object>) expected.get('lines')) {
                List<Object> l = (List<Object>) raw;
                lines.add(new GuardrailService.Line(num(l[0]), num(l[1]), num(l[2]), num(l[3])));
            }
            String deal = (String) expected.get('deal');
            GuardrailService.DealScore actual = GuardrailService.scoreDeal(lines);
            Assert.areEqual(expected.get('verdict'), actual.verdict, deal);
            Assert.areEqual(expected.get('approver'), actual.approver, deal);
            Assert.areEqual(expected.get('worstLine'), actual.worstLine, deal);
            near(num(expected.get('blendedMarginPct')), actual.blendedMarginPct, deal + ' blended margin');
            near(num(expected.get('gapDollars')), actual.gapDollars, deal + ' margin given up');
            List<Object> lineVerdicts = (List<Object>) expected.get('lineVerdicts');
            List<Object> lineApprovers = (List<Object>) expected.get('lineApprovers');
            for (Integer i = 0; i < actual.lines.size(); i++) {
                Assert.areEqual(lineVerdicts[i], actual.lines[i].verdict, deal + ' line ' + i);
                Assert.areEqual(lineApprovers[i], actual.lines[i].approver, deal + ' line ' + i);
            }
        }
    }

    // JSON numbers arrive as Integer, Long or Decimal; the guardrail runs on Doubles.
    private static Double num(Object value) {
        return value instanceof Decimal ? ((Decimal) value).doubleValue() : Double.valueOf(String.valueOf(value));
    }
}
